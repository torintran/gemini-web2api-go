# Copy thành deploy/k3s/secrets/app-secrets.env rồi điền giá trị thật.
# deploy/k3s/secrets/ đã gitignore. KHÔNG commit file .env.
#
# Sinh giá trị:
#   openssl rand -hex 32
#   echo "sk-gemini-$(openssl rand -hex 24)"
ADMIN_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
API_KEY=sk-gemini-REPLACE_WITH_RANDOM
